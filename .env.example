# Leftover Chef - Environment Configuration Example
# Copy this file to .env for local overrides. Never commit real secrets to version control.

# Application Settings
APP_NAME="Leftover Chef"
APP_ENV="development"
APP_VERSION="1.0.0"
DEBUG=false

# Database Configuration (SQLite default for local development; PostgreSQL supported in production)
DATABASE_URL="sqlite:///./leftover_chef.db"

# Security & Session Configuration
# Generate a strong secret key in production: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
RATE_LIMIT_PER_MINUTE=120

# Optional AI Feature Configuration (Core recipe search works 100% locally without AI)
ENABLE_OPTIONAL_AI=false
AI_PROVIDER_API_KEY=""
AI_REQUEST_TIMEOUT_SECONDS=8
